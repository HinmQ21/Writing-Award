GEMINI_API_KEY=
# Optional server-side overrides. Default model roles follow the v1.1 design.
GEMINI_ANALYZER_MODEL=gemini-3.5-flash-lite
GEMINI_EXAMINER_MODEL=gemini-3.8-flash
