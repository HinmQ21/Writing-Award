      "html": "<button class=\"ds-text-action\" type=\"button\">M?t m?nh ???c t?nh th? n?o? <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-7-7 7 7-7 7\"/></svg></button>",
      "css": ".ds-text-action{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:36px;padding:5px 0;border:0;background:transparent;color:var(--color-primary);font-family:'Nunito Sans',sans-serif;font-size:12px;cursor:pointer;}.ds-text-action:hover:not(:disabled){text-decoration:underline;text-underline-offset:4px;}.ds-text-action:focus-visible{outline:3px solid var(--color-primary);outline-offset:4px;}.ds-text-action:disabled{opacity:.55;cursor:not-allowed;}"
    },
    {
      "name": "Scene Control Tray",
      "kind": "custom",
      "refersTo": "scene-controls",
      "description": "Floating icon buttons provide alternatives to drag, with 44px height. Preview buttons illustrate the source control appearance.",
      "html": "<div class=\"ds-scene-tray\" role=\"group\" aria-label=\"?i?u khi?n m? h?nh\"><button class=\"ds-scene-icon\" type=\"button\" aria-label=\"Xoay m? h?nh sang tr?i\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m15 18-6-6 6-6\"/></svg></button><button class=\"ds-scene-icon\" type=\"button\" aria-label=\"Xoay m? h?nh sang ph?i\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m9 18 6-6-6-6\"/></svg></button><button class=\"ds-scene-icon\" type=\"button\" aria-label=\"Thu nh? m? h?nh\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14\"/></svg></button><button class=\"ds-scene-icon\" type=\"button\" aria-label=\"Ph?ng to m? h?nh\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 5v14m-7-7h14\"/></svg></button><button class=\"ds-scene-icon\" type=\"button\" aria-label=\"??t l?i g?c nh?n\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 11a9 9 0 1 1 2.7 6.4M3 4v7h7\"/></svg></button></div>",
      "css": ".ds-scene-tray{display:inline-flex;align-items:center;padding:2px 4px;background:var(--color-surface);border-radius:30px;box-shadow:var(--shadow-float);}.ds-scene-icon{display:inline-flex;align-items:center;justify-content:center;width:40px;height:44px;padding:0;border:0;border-radius:50%;color:var(--color-muted);background:transparent;cursor:pointer;transition:color var(--duration-fast),background var(--duration-fast);}.ds-scene-icon:hover{color:var(--color-primary);background:var(--color-primary-soft);}.ds-scene-icon:focus-visible{outline:3px solid var(--color-primary);outline-offset:4px;}@media(max-width:374px){.ds-scene-icon{width:38px;}}"
    },
    {
      "name": "Essay Editor",
      "kind": "input",
      "refersTo": "essay-editor",
      "description": "Reading-sized essay input, draft status and live-threshold presentation within one frame. The preview is editable; its count is illustrative.",
      "html": "<div class=\"ds-editor\"><label class=\"ds-editor-label\" for=\"ds-essay\">B?i vi?t IELTS Writing Task 2</label><textarea id=\"ds-essay\" class=\"ds-editor-input\" placeholder=\"D?n b?i Writing Task 2 c?a b?n v?o ??y?\" lang=\"en\"></textarea><div class=\"ds-editor-footer\"><span>Kho?ng nh? c?a b?n</span><span><strong>0</strong> / 250 t?</span></div></div>",
      "css": ".ds-editor{max-width:420px;border:1px solid var(--color-border-strong);border-radius:var(--radius-md);overflow:hidden;color:var(--color-text);background:var(--color-surface);font-family:'Nunito Sans',sans-serif;transition:border-color var(--duration-fast),box-shadow var(--duration-fast);}.ds-editor-label{position:absolute;width:1px;height:1px;padding:0;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;}.ds-editor:focus-within{border-color:var(--color-primary);box-shadow:0 0 0 2px var(--color-primary-soft);}.ds-editor-input{display:block;width:100%;height:230px;min-height:160px;padding:16px 14px 6px;border:0;outline:0;resize:vertical;background:var(--color-surface);color:var(--color-text);font-family:'Nunito Sans',sans-serif;font-size:16px;line-height:1.8;caret-color:var(--color-primary);}.ds-editor-input::placeholder{color:var(--color-muted);opacity:1;font-size:14px;}.ds-editor-footer{display:flex;justify-content:space-between;gap:6px;padding:8px 12px 12px;color:var(--color-muted);font-size:11px;font-variant-numeric:tabular-nums;}@media(max-width:760px){.ds-editor-input{height:250px;padding:16px;}.ds-editor-footer{padding:10px 12px 12px;}}"
    },
    {
      "name": "Current Navigation",
      "kind": "nav",
      "refersTo": "nav-active",
      "description": "Selected desktop navigation; mobile uses the same state with icon above label.",
      "html": "<nav class=\"ds-nav\" aria-label=\"?i?u h??ng ch?nh\"><a class=\"ds-nav-link\" href=\"#home\" aria-current=\"page\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"21\" height=\"21\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m3 10 9-7 9 7\"/><path d=\"M5 9v10a2 2 0 0 0 2 2h3v-7h4v7h3a2 2 0 0 0 2-2V9\"/></svg><span>G?c c?a b?n</span><span class=\"ds-nav-dot\"></span></a></nav>",
      "css": ".ds-nav{width:180px;font-family:'Nunito Sans',sans-serif;}.ds-nav-link{display:flex;align-items:center;gap:12px;min-height:48px;padding:0 16px;border-radius:var(--radius-md);text-decoration:none;color:var(--color-primary);background:var(--color-primary-soft);font-size:14px;font-weight:700;transition:background var(--duration-fast),color var(--duration-fast);}.ds-nav-link:hover{background:var(--color-primary-soft);}.ds-nav-link:focus-visible{outline:3px solid var(--color-primary);outline-offset:4px;}.ds-nav-dot{width:5px;height:5px;border-radius:50%;background:var(--color-primary);margin-left:auto;}"
    },
    {
      "name": "Achievement Chip",
      "kind": "chip",
      "refersTo": "achievement-chip",
      "description": "Noninteractive earned-state label with explicit text and icon.",
      "html": "<span class=\"ds-achievement\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m9 12 2 2 4-4\"/><circle cx=\"12\" cy=\"12\" r=\"10\"/></svg> ?? ho?n th?nh ? 21/21 m?nh</span>",
      "css": ".ds-achievement{display:inline-flex;align-items:center;gap:6px;min-height:34px;padding:6px 10px;border-radius:var(--radius-sm);background:var(--color-mint);color:var(--color-success);font-family:'Nunito Sans',sans-serif;font-size:11px;}"
    },
    {
      "name": "Quiet Surface",
      "kind": "card",
      "refersTo": "surface",
      "description": "The warm bordered frame shared by writing, world and journal surfaces.",
      "html": "<section class=\"ds-surface\"><h2 class=\"ds-surface-title\">H?m nay, b?n vi?t g??</h2><p class=\"ds-surface-copy\">D?nh m?t ch?t th?i gian cho m?nh.<br>Capy s? ch? b?n ? ??y.</p></section>",
      "css": ".ds-surface{max-width:420px;padding:26px 24px 21px;border:1px solid var(--color-border);border-radius:var(--radius-lg);background:var(--color-surface);color:var(--color-text);}.ds-surface-title{margin:0;font-family:'Nunito',sans-serif;font-size:21px;font-weight:800;line-height:1.3;letter-spacing:-.015em;text-wrap:balance;}.ds-surface-copy{margin:9px 0 0;font-family:'Nunito Sans',sans-serif;font-size:14px;font-weight:400;line-height:1.7;color:var(--color-muted);}"
    },
    {
      "name": "Earned Construction Progress",
      "kind": "custom",
      "description": "The source 21-step progress pattern ties the visible model to daily pieces; this is a static 12-piece example.",
      "html": "<section class=\"ds-progress\"><div class=\"ds-progress-heading\"><span>T?ng m?nh nh?, th?nh t? ?m</span><strong>12<span> / 21 m?nh</span></strong></div><div class=\"ds-piece-track\" role=\"progressbar\" aria-label=\"Ti?n ?? x?y d?ng th? gi?i\" aria-valuenow=\"12\" aria-valuemin=\"0\" aria-valuemax=\"21\"><span class=\"ds-piece ds-earned\"></span><span class=\"ds-piece ds-earned\"></span><span class=\"ds-piece ds-earned\"></span><span class=\"ds-piece ds-earned\"></span><span class=\"ds-piece ds-earned\"></span><span class=\"ds-piece ds-earned\"></span><span class=\"ds-piece ds-earned\"></span><span class=\"ds-piece ds-earned\"></span><span class=\"ds-piece ds-earned\"></span><span class=\"ds-piece ds-earned\"></span><span class=\"ds-piece ds-earned\"></span><span class=\"ds-piece ds-earned\"></span><span class=\"ds-piece \"></span><span class=\"ds-piece \"></span><span class=\"ds-piece \"></span><span class=\"ds-piece \"></span><span class=\"ds-piece \"></span><span class=\"ds-piece \"></span><span class=\"ds-piece \"></span><span class=\"ds-piece \"></span><span class=\"ds-piece \"></span></div><div class=\"ds-progress-footer\"><span>C?n 9 ng?y vi?t ?? ho?n th?nh th? gi?i n?y.</span><a class=\"ds-progress-link\" href=\"#collection\">B? s?u t?p <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-7-7 7 7-7 7\"/></svg></a></div></section>",
      "css": ".ds-progress{max-width:560px;padding:21px 24px 22px;background:var(--color-surface);font-family:'Nunito Sans',sans-serif;color:var(--color-text);}.ds-progress-heading{display:flex;justify-content:space-between;align-items:center;gap:12px;font-size:12px;}.ds-progress-heading>span{font-weight:600;}.ds-progress-heading>strong{font-family:'Nunito',sans-serif;font-size:19px;font-weight:800;color:var(--color-primary);font-variant-numeric:tabular-nums;}.ds-progress-heading>strong>span{font-family:'Nunito Sans',sans-serif;font-size:11px;font-weight:400;color:var(--color-muted);}.ds-piece-track{display:flex;gap:4px;width:100%;margin:13px 0 11px;}.ds-piece{flex:1;height:8px;border-radius:3px;background:var(--color-primary-soft);}.ds-earned{background:var(--color-lavender);}.ds-progress-footer{display:flex;justify-content:space-between;align-items:center;gap:8px;color:var(--color-muted);font-size:12px;line-height:1.5;}.ds-progress-link{display:inline-flex;align-items:center;gap:5px;min-height:28px;color:var(--color-primary);text-decoration:none;white-space:nowrap;font-weight:600;}.ds-progress-link:hover{text-decoration:underline;text-underline-offset:4px;}.ds-progress-link:focus-visible{outline:3px solid var(--color-primary);outline-offset:4px;}@media(max-width:760px){.ds-progress{padding:20px;}.ds-piece-track{gap:3px;}.ds-progress-footer{align-items:flex-start;}.ds-progress-footer>span{max-width:23ch;}}"
    }
  ],
  "narrative": {
    "northStar": "One essay. One little piece of happiness.",
    "overview": "Writing Award makes daily effort tangible through Capy's lasting toy cottage and the worlds that follow it. Ivory paper, rounded lettering and soft physical materials give the working interface a gentle, welcoming mood. Vietnamese guidance encourages returning to write; the visual reward is construction rather than a grade.\n\nThe interface stays calm around the dimensional scene. Warm borders and tonal surfaces organize controls, while ambient light, rounded geometry and actual earned pieces carry the playful character. This is the shipped procedural Phase 1 world: the cottage, tree and capybara are rendered in Three.js; no raster scene artwork or finished GLB asset is implied. The supplied design document and concept image establish the identity; current source establishes the exact tokens.",
    "keyCharacteristics": [
      "Ivory and warm brown make a legible reading ground.",
      "Dark lavender marks action, selection and focus; pastels support progress and warmth.",
      "Nunito headings pair with Nunito Sans reading and controls.",
      "Quiet bordered surfaces surround a softly lit, tangible toy world.",
      "Earned construction persists, with bounded celebration and reduced-motion support."
    ],
    "rules": [
      {
        "name": "The Pastel Ground Rule",
        "body": "Use deep lavender, warm brown or leaf green for operational text; use pale lavender, peach and mint as supporting grounds or object color.",
        "section": "colors"
      },
      {
        "name": "The Clear Reading Rule",
        "body": "Keep essay text in Nunito Sans at 16px; preserve the separate rounded heading voice for orientation and reward.",
        "section": "typography"
      },
      {
        "name": "The Quiet Frame Rule",
        "body": "Let the toy scene carry physical richness; keep working containers bordered and calm rather than adding clay shadows to every interface surface.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use deep lavender for action, selection and focus, with pastel grounds supporting the state.",
      "Do use Nunito for rounded headings and Nunito Sans for essays and controls, retaining Vietnamese and Latin coverage.",
      "Do start from the shared spacing and corner scales, then preserve documented optical adjustments.",
      "Do keep visible controls, keyboard focus and text labels alongside scene interaction and color states.",
      "Do show the actual earned piece and keep a settled reduced-motion alternative.",
      "Do label demonstration progress and supported input formats in the same calm visual voice."
    ],
    "donts": [
      "Don't use pale lavender as operational text on ivory.",
      "Don't turn the working interface into a score dashboard or replace the supplied pastel toy identity with a generic marketing palette.",
      "Don't add thick clay borders or layered sculptural shadows to ordinary writing and navigation surfaces.",
      "Don't make dragging or animation the only way to understand or operate the scene.",
      "Don't imply raster scene artwork, production GLB fidelity or physical-device verification that this procedural Phase 1 build does not supply."
    ]
  }
}
